# Seeded on first startup. Use a real address and a generated password.
STACKFORGE_ADMIN_EMAIL=admin@example.internal
STACKFORGE_ADMIN_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=stackforge
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=stackforge
DATABASE_URL=postgresql+asyncpg://stackforge:replace-with-a-long-random-password@stackforge-postgres:5432/stackforge
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
DEFAULT_MODEL=gpt-4o
PROJECTS_ROOT=/data/projects
# Replace 192.0.2.10 with this server's LAN IP. sslip.io resolves any hostname
# containing an IPv4 address back to that address, so no local DNS setup is needed.
PREVIEW_BASE_DOMAIN=192.0.2.10.sslip.io:18181
PREVIEW_BASE_DOMAIN_HOST=192.0.2.10.sslip.io
MAX_CONCURRENT_PREVIEWS=3
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
STACKFORGE_RUNNER_URL=http://stackforge-runner:9000
STACKFORGE_TEMPLATES_ROOT=/templates
# Absolute path to volumes/projects on the HOST, as the Docker daemon sees it.
PROJECTS_HOST_ROOT=/srv/stackforge/volumes/projects
STACKFORGE_RUNNER_TOKEN=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
STACKFORGE_PROXY_HTTP_PORT=18181
STACKFORGE_PROXY_HTTPS_PORT=18443
